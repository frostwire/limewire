<project name="Rococoa Cocoa" default="dist" basedir=".">
   <!-- set global properties for this build -->
   <property name="src" location="src/main/java"/>
   <property name="lib" location="../lib"/>
   <property name="build" location="ant_build"/>
   <property name="dist"  location="ant_dist"/>
   <property name="bin"  location="../bin"/>
   <property name="rococoa-core"  location="../rococoa-core/target"/>
   

   <path id="build.path">
      <fileset dir="${lib}">
         <include name="asm-3.1.jar"/>
         <include name="cglib-2.2.jar"/>
         <include name="jna-3.2.2.jar"/>
         <include name="slf4j-api-1.5.8.jar"/>
      </fileset>
   </path>

   <path id="run.path">
      <pathelement location="${build}"/>
      <fileset dir="${lib}">
         <include name="*.jar"/>
      </fileset>
   </path>
 

  <target name="init">
    <!-- Create the time stamp -->
    <tstamp/>
    <!-- Create the build directory structure used by compile -->
    <mkdir dir="${build}"/>
  </target>

<!-- Compile the java code from ${src} into ${build} -->
  <target name="compile" depends="init"
        description="compile the source " >
    <javac srcdir="${src}" excludes="org/rococoa/test/**" destdir="${build}" classpathref="build.path"/>
  </target>

  <target name="dist" depends="compile"
        description="generate the distribution" >
    <!-- Create the distribution directory -->
    <mkdir dir="${dist}/lib"/>

    <!-- Put everything in ${build} into the MyProject-${DSTAMP}.jar file -->
    <!--jar jarfile="${dist}/lib/rococoa-core-${DSTAMP}.jar" basedir="${build}"/-->
    <jar jarfile="${dist}/lib/rococoa-core.jar" basedir="${build}"/>
  </target>

  <target name="clean"
        description="clean up" >
    <!-- Delete the ${build} and ${dist} directory trees -->
    <delete dir="${build}"/>
    <delete dir="${dist}"/>
  </target>

  <target name="run">
    <java classname="PlayMovieExample" classpathref="run.path" fork="true">
      <jvmarg value="-Djava.library.path=../bin" />
      <jvmarg value="-Djna.library.path=../bin" />
    </java>
  </target>

</project>

