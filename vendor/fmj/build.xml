        <!-- zip/tar: -->

        <delete dir="${dist-zip}" />
        <mkdir dir="${dist-zip}" />

        <zip zipfile="${dist-zip}/fmj-${DSTAMP}-${TSTAMP}.zip">
            <zipfileset dir="${dist}">
            </zipfileset>
        </zip>

        <tar longfile="gnu" destfile="${dist-zip}/fmj-${DSTAMP}-${TSTAMP}.tar.gz" compression="gzip">
              <tarfileset dir="${dist}/.." mode="755">
                <include name="fmj/*.sh"/>
              </tarfileset>
              <tarfileset dir="${dist}/..">
                <include name="fmj/**"/>
                <exclude name="fmj/*.sh"/>
              </tarfileset>
        </tar>

    </target>

