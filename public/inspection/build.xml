<project name="inspection-tool" default="compile" basedir=".">
	
  <property name="build.classes" value="bin" />
  <property name="src.home"      value="src/main/java" />
  <property name="dist"			     value="dist" />

  <path id="compile.classpath">
    <fileset dir="lib">
      <include name="*.jar"/>
    </fileset>
    <fileset dir="${ant.home}/lib">
      <include name="*.jar"/>
    </fileset>
  </path>
  
  <target name="compile">
    <mkdir dir="${build.classes}"/>
    <javac srcdir="${src.home}"
           destdir="${build.classes}"
		   source="1.5"
		   target="1.5">
      <classpath refid="compile.classpath"/>
    </javac>
  </target>
  
  <target name="jar" depends="clean,compile">
    <mkdir dir="${dist}" />
    <jar destfile="${dist}/inspTool.jar" basedir="${build.classes}" />
  </target>

  <target name="clean">
    <delete dir="${build.classes}"/>
    <delete dir="${dist}" />
  </target>

</project>
