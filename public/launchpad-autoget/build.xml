<project name="launchpad-autoget" default="compile" basedir=".">
	
  <property name="build.classes" value="bin" />
  <property name="src.home"      value="src/main/java" />

  <path id="compile.classpath">
    <fileset dir="lib">
      <include name="*.jar"/>
    </fileset>
    <fileset dir="${ant.home}/lib">
      <include name="*.jar"/>
    </fileset>
  </path>
  
  <target name="compile">
    <mkdir dir="${build.classes}"/>
    <javac srcdir="${src.home}"
           destdir="${build.classes}">
      <classpath refid="compile.classpath"/>
    </javac>
  </target>

  <target name="clean">
    <delete dir="${build.classes}"/>
  </target>

</project>
