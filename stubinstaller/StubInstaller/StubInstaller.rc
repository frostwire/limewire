IDD_STUBINSTALLER_DIALOG DIALOGEX 0, 0, 332, 74
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | 
    WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "LimeWire Online Installer"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    CONTROL         "",IDC_PROGRESS,"msctls_progress32",WS_BORDER | 0x1,7,32,
                    318,13
    CTEXT           "<Initial Text>",IDC_STATUS,7,55,318,12
    ICON            IDR_MAINFRAME,IDC_LIME_ICON,7,7,21,20
    CTEXT           "Please wait...  If there is no progress for several minutes, please restart the installer.",
                    IDC_STATIC,41,12,284,10
END

IDD_FIREWALL_WARNING DIALOGEX 0, 0, 266, 69
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | 
    WS_SYSMENU
CAPTION "LimeWire Online Installer"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
